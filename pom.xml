<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.yourname</groupId>
    <artifactId>AvenoxLeaderboard</artifactId>
    <version>2.2.0</version>
    <packaging>jar</packaging>

    <name>AvenoxLeaderboard</name>
    <description>Avenox Leaderboard PlaceholderAPI-driven leaderboard engine with a modern GUI, for Paper and Folia.</description>

    <properties>
        <!-- Single source of truth for the Java level - do not also set source/target,
             mixing the two can silently diverge on some toolchains. Bumped 21 -> 25 per
             explicit request to build/run against Java 25. -->
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- Only repositories an actual dependency below requires. HikariCP, sqlite-jdbc,
         mysql-connector-j and junit-jupiter all resolve from Maven Central, which every
         Maven installation includes implicitly - no extra <repository> entry needed for them.
         jitpack.io and the Sonatype OSS mirror were previously added only to reach VaultAPI;
         now that VaultHook/VaultAPI have been removed (Vault values reach leaderboards through
         PlaceholderAPI's own %vault_*% expansion instead), neither repository is required. -->
    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.20.6-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>7.1.0</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.53.2.1</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.4.0</version>
            <scope>compile</scope>
            <!-- We only use plain JDBC (Connection/PreparedStatement/ResultSet), never the
                 X DevAPI, so the connector's transitive protobuf-java dependency is dead
                 weight in the shaded jar - MySQL's own docs recommend excluding it when
                 X DevAPI isn't used. -->
            <exclusions>
                <exclusion>
                    <groupId>com.google.protobuf</groupId>
                    <artifactId>protobuf-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <!-- Only plugin.yml gets variable interpolation (so ${project.version} actually
             resolves to a real version string in the running plugin's console output).
             Every other resource is copied byte-for-byte unfiltered, so nothing in
             config.yml/messages.yml/gui.yml/leaderboards.yml/storage.yml - including any
             future MiniMessage/placeholder tokens that might resemble ${...} - risks being
             silently mangled by Maven's resource filtering. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!-- Explicit surefire version: the default version bound by old super-POMs does
                 not reliably auto-detect the JUnit 5 (junit-platform) engine, which would
                 make `mvn test` silently run zero tests instead of failing loudly. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <!-- 3.5.2 has no support at all for Java 25 class files (major version 69);
                     Java 25 support only started landing in 3.6.1 and had lingering bugs
                     there too (github.com/apache/maven-shade-plugin issue #791) - 3.6.2 is
                     the first version with the full set of Java 25 / ASM fixes. This matters
                     here specifically: our own compiled classes are now Java-25 bytecode,
                     and if shade can't parse a class file it may (depending on version)
                     either hard-fail the build or silently skip processing that file - which
                     is the most likely explanation for the prior HikariCP relocation leaving
                     our own SQLiteStorage.class still pointing at the original, unrelocated
                     com.zaxxer.hikari package while the dependency itself got renamed out
                     from under it, producing NoClassDefFoundError at runtime. -->
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <!-- No relocations. This is a leaf plugin jar, not a shared
                                 library other plugins compile against, so there is no real
                                 classpath-collision benefit to relocating HikariCP - and
                                 relocation is exactly the kind of extra bytecode-rewriting
                                 step that interacts badly with tooling/JDK version drift, as
                                 above. Keep packaging as simple as the problem requires. -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <minimizeJar>false</minimizeJar>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                                <!-- org.xerial:sqlite-jdbc bundles a precompiled native SQLite
                                     binary for a long list of OS/architecture combinations
                                     under org/sqlite/native/... - this is the well-documented,
                                     industry-known reason this one dependency alone is
                                     typically 10+ MB despite being "just a JDBC driver," and is
                                     almost certainly the dominant contributor to this plugin's
                                     ~15MB jar (HikariCP is a few hundred KB; mysql-connector-j,
                                     with its protobuf-java dependency already excluded above in
                                     the <dependencies> section, is a few MB of pure Java).
                                     Trimmed here to the platforms an actual Minecraft server
                                     deployment realistically needs: Linux x86_64/aarch64 (the
                                     overwhelming majority of real server hosts), Windows x86_64
                                     (small hosts and local testing - this is what you're
                                     building on), and Mac x86_64/aarch64 (developer machines).
                                     Excluded: 32-bit x86, ARMv6/v7 (Raspberry Pi-class), PPC64,
                                     s390x, RISC-V, musl/Alpine, Android, FreeBSD, Windows
                                     x86/arm64 variants.
                                     IMPORTANT - I could not verify these exact path names
                                     against the real jar in this environment (no Maven Central
                                     access to download and inspect it). These match sqlite-jdbc's
                                     long-documented native-layout convention, but if a path is
                                     wrong for 3.53.2.1 specifically, Maven simply won't match
                                     anything there (silently a no-op, not a build failure) and
                                     you won't see the size drop. Verify after building with:
                                       jar tf target/AvenoxLeaderboard-1.0.0.jar | grep org/sqlite/native
                                     and adjust the excludes below to match what you actually see. -->
                                <filter>
                                    <artifact>org.xerial:sqlite-jdbc</artifact>
                                    <excludes>
                                        <exclude>org/sqlite/native/Linux/x86/**</exclude>
                                        <exclude>org/sqlite/native/Linux/arm/**</exclude>
                                        <exclude>org/sqlite/native/Linux/armv6/**</exclude>
                                        <exclude>org/sqlite/native/Linux/armv7/**</exclude>
                                        <exclude>org/sqlite/native/Linux/ppc64/**</exclude>
                                        <exclude>org/sqlite/native/Linux/s390x/**</exclude>
                                        <exclude>org/sqlite/native/Linux/riscv64/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Musl/**</exclude>
                                        <exclude>org/sqlite/native/Linux-Android/**</exclude>
                                        <exclude>org/sqlite/native/FreeBSD/**</exclude>
                                        <exclude>org/sqlite/native/Windows/x86/**</exclude>
                                        <exclude>org/sqlite/native/Windows/arm64/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
